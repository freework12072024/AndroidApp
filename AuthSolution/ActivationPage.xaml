<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AuthSolution.ActivationPage"
             Title="Activate Account">
    <VerticalStackLayout Padding="20" Spacing="10">
        <Label Text="Enter activation code sent to your email" />
        <Entry x:Name="EmailEntry" Placeholder="Email" IsReadOnly="True" />
        <Entry x:Name="CodeEntry" Placeholder="Activation code" Keyboard="Numeric" />
        <Button Text="Activate" Clicked="OnActivateClicked" />
        <Button Text="Resend" Clicked="OnResendClicked" />
    </VerticalStackLayout>
</ContentPage>