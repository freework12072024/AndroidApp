<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
x:Class="AuthSolution.ResetPage"
Title="Reset Password">
    <VerticalStackLayout Padding="20">
        <Entry x:Name="TokenEntry" Placeholder="Enter token from email" />
        <Entry x:Name="PasswordEntry" Placeholder="Enter New Password" IsPassword="True" />
        <Button Text="Reset Password" Clicked="OnResetClicked" />
    </VerticalStackLayout>
</ContentPage>